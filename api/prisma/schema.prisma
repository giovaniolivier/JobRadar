generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  TO_APPLY
  APPLIED
  INTERVIEW
  RESPONSE
}

model User {
  id             String            @id @default(cuid())
  email          String            @unique
  passwordHash   String?
  name           String
  googleId       String?           @unique
  linkedinId     String?           @unique
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  profile        Profile?
  settings       UserSettings?
  jobs           Job[]
  analyses       Analysis[]
  applications   Application[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordResetToken[]
  loginOtps      LoginOtp[]
  emailDispatchLogs EmailDispatchLog[]
}

model LoginOtp {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeHash String    @unique
  codeHash      String
  remember      Boolean   @default(true)
  attempts      Int       @default(0)
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Profile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvText              String    @default("")
  cvFileName          String?
  cvImportedAt        DateTime?
  skills              String[]  @default([])
  softSkills          String[]  @default([])
  targetRoles         String[]  @default([])
  experienceYears     Int?
  preferredLocations  String[]  @default([])
  salaryMin           Int?
  salaryMax           Int?
  workModes           String[]  @default([])
  targetSeniority     String?
  preferredSectors    String[]  @default([])
  avoidedSectors      String[]  @default([])
  updatedAt           DateTime  @updatedAt
}

model UserSettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications  Boolean  @default(true)
  inAppNotifications  Boolean  @default(true)
  notifyHighScore     Boolean  @default(true)
  notifyFollowUp      Boolean  @default(true)
  notifyInterview     Boolean  @default(true)
  notifyWeeklyDigest  Boolean  @default(false)
  digestFrequency     String   @default("weekly")
  theme               String   @default("system")
  locale              String   @default("fr")
  dateFormat          String   @default("fr-FR")
  currency            String   @default("EUR")
  lastDigestEmailAt   DateTime?
  updatedAt           DateTime @updatedAt
}

/// Déduplique les emails transactionnels (score, relance, entretien).
model EmailDispatchLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// ex. high:{analysisId} | followup:{appId} | interview:{appId}:{day}
  key       String
  sentAt    DateTime @default(now())

  @@unique([userId, key])
  @@index([userId])
}

model Job {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  source       String
  externalId   String?
  title        String
  company      String
  location     String?
  salaryRaw    String?
  description  String
  techStack    String[]      @default([])
  seniority    String?
  url          String?
  fetchedAt    DateTime      @default(now())
  createdAt    DateTime      @default(now())
  analyses     Analysis[]
  applications Application[]

  @@unique([userId, source, externalId])
  @@index([userId])
  @@index([title])
  @@index([company])
}

model Analysis {
  id                 String   @id @default(cuid())
  jobId              String
  userId             String
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  relevanceScore     Int
  redFlags           String[] @default([])
  strengths          String[] @default([])
  gaps               String[] @default([])
  summary            String
  extractedSalary    String?
  extractedStack     String[] @default([])
  extractedSeniority String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([jobId, userId])
  @@index([relevanceScore])
}

model Application {
  id            String            @id @default(cuid())
  jobId         String
  userId        String
  job           Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        ApplicationStatus @default(TO_APPLY)
  /// accepted | rejected | null (pertinent quand status = RESPONSE)
  outcome       String?
  notes         String?
  coverLetter   String?
  /// [{ "status": "APPLIED", "at": "ISO" }, ...]
  statusHistory Json              @default("[]")
  followUpAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([jobId, userId])
  @@index([status])
}
