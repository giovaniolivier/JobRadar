# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobradar?schema=public"

# API
PORT=4000
NODE_ENV=development
# Prod: long random secret, min 32 chars (required in production)
JWT_SECRET="replace-with-a-long-unique-random-secret-min-32-chars"
CORS_ORIGIN="http://localhost:5173"
# Public web URL (liens dans les emails de notifs)
APP_ORIGIN="http://localhost:5173"

# IA — gratuit recommandé : Gemini et/ou Groq ; Claude optionnel
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-3.6-flash"

# https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"
# GROQ_MODEL="openai/gpt-oss-20b"

# En auto : Gemini → Groq → Claude (bascule si quota / 503 / réponse vide)
# Pour privilégier Groq (recommandé si Gemini instable) :
# AI_PROVIDER=groq


# Anthropic (Claude) — optionnel
ANTHROPIC_API_KEY="sk-ant-your-key-here"
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Email — Brevo (OTP, reset, notifs). Test : npm run mail:test
# Compte : https://app.brevo.com/ → Settings → SMTP & API → SMTP
# 1) Créer une clé SMTP
# 2) Senders : vérifier l’adresse utilisée dans MAIL_FROM
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT="587"
# Sur Render (plan gratuit) les ports 25 / 465 / 587 sont bloqués en sortie :
# utiliser SMTP_PORT="2525" (Brevo accepte 2525 en STARTTLS).
SMTP_USER="your-brevo-smtp-login"
SMTP_PASS="your-brevo-smtp-key"
MAIL_FROM="JobRadar <noreply@yourdomain.com>"
# L'API démarre même si SMTP est mal configuré (vérif. en arrière-plan, état sur /health).
# Attention : la connexion par mot de passe envoie un code OTP par e-mail, donc sans
# SMTP fonctionnel l'envoi échoue (503) et la connexion est bloquée.
# LOGIN_OTP_REQUIRED=false : connexion mot de passe seul, sans code par e-mail.
#   Utile quand l'hébergeur bloque le SMTP sortant (Render gratuit) ; à remettre
#   à "true" dès que /health indique mail.verified: true.
LOGIN_OTP_REQUIRED="true"
# MAIL_REQUIRED=false autorise l'envoi silencieux sans SMTP : OTP/reset/notifs désactivés
# et codes de connexion renvoyés par l’API (devCode) — NE PAS utiliser en public.
# MAIL_REQUIRED="true"
# MAIL_TO="you@gmail.com"
#
# Fallback Gmail (dev) :
# SMTP_HOST="smtp.gmail.com"
# SMTP_USER="you@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# MAIL_FROM="JobRadar <you@gmail.com>"
#
# Ou URL unique :
# SMTP_URL="smtps://user:pass@smtp.example.com:465"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:4000/auth/linkedin/callback"
