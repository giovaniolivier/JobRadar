# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobradar?schema=public"

# API
PORT=4000
NODE_ENV=development
# Prod: long random secret, min 32 chars (required in production)
JWT_SECRET="replace-with-a-long-unique-random-secret-min-32-chars"
CORS_ORIGIN="http://localhost:5173"
# Public web URL (liens dans les emails de notifs)
APP_ORIGIN="http://localhost:5173"

# IA — gratuit recommandé : Gemini et/ou Groq ; Claude optionnel
# https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"
# GEMINI_MODEL="gemini-3.6-flash"

# https://console.groq.com/keys
GROQ_API_KEY="your-groq-api-key"
# GROQ_MODEL="openai/gpt-oss-20b"

# En auto : Gemini → Groq → Claude (bascule si quota / 503 / réponse vide)
# Pour privilégier Groq (recommandé si Gemini instable) :
# AI_PROVIDER=groq


# Anthropic (Claude) — optionnel
ANTHROPIC_API_KEY="sk-ant-your-key-here"
# ANTHROPIC_MODEL="claude-sonnet-4-6"

# Email — required to send 2FA codes / reset links / notification emails
# Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="you@gmail.com"
SMTP_PASS="your-16-char-app-password"
MAIL_FROM="JobRadar <you@gmail.com>"
# Or a single URL instead of HOST/USER/PASS:
# SMTP_URL="smtps://user:pass@smtp.example.com:465"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/auth/google/callback"
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
LINKEDIN_REDIRECT_URI="http://localhost:4000/auth/linkedin/callback"
